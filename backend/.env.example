# Frambit Backend Production Environment Variables Template (Render)

# 1. Django Core Security
# Generate a secret key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here
DEBUG=False

# Allowed hosts (comma-separated, without http://)
# Example: .onrender.com,frambit-api.onrender.com,localhost
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# 2. Database Connection
# Render Managed PostgreSQL / Neon Serverless Postgres connection string
# Example: postgresql://frambit_user:password@dpg-xxxx.oregon-postgres.render.com/frambit_db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 3. CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=True
# Or lock down to Vercel production frontend:
# CORS_ALLOWED_ORIGINS=https://frambit.vercel.app,https://your-custom-domain.com

CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app

# 4. ImageKit CDN Credentials (Media uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
