# Frambit Frontend Production Environment Variables Template (Vercel)

# 1. Backend REST API URL on Render (without trailing slash, or with /api)
# Example: https://frambit-api.onrender.com/api
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api

# 2. Firebase Realtime Messaging & Auth
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef

# 3. ImageKit Client Credentials (Media upload & delivery)
VITE_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
